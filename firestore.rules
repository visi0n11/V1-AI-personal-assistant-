rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidTask(data) {
      return data.text is string && data.text.size() > 0 && data.text.size() < 500 &&
             data.completed is bool &&
             data.category in ['study', 'personal', 'work'];
    }

    function isValidNote(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.content is string && data.content.size() < 5000 &&
             data.date is string;
    }

    function isValidMessage(data) {
      return data.contactId is string &&
             data.text is string && data.text.size() < 1000 &&
             data.timestamp is string &&
             data.incoming is bool;
    }

    // Public access for all collections as requested
    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if isValidTask(request.resource.data);
      allow delete: if true;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow create, update: if isValidNote(request.resource.data);
      allow delete: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create, update: if isValidMessage(request.resource.data);
      allow delete: if true;
    }
  }
}
